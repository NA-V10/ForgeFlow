# Copy to .env. All settings are optional for local development.
FORGEFLOW_DATA_DIR=.forgeflow
# FORGEFLOW_DATABASE_URL=postgresql+psycopg://forgeflow:forgeflow@localhost:5432/forgeflow
# FORGEFLOW_REDIS_URL=redis://localhost:6379/0
# FORGEFLOW_S3_ENDPOINT=http://localhost:9000
# FORGEFLOW_S3_ACCESS_KEY=forgeflow
# FORGEFLOW_S3_SECRET_KEY=forgeflow-secret
FORGEFLOW_SANDBOX=local
FORGEFLOW_AUTH_MODE=dev
FORGEFLOW_ADMIN_TOKEN=change-me
